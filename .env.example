# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web). These identify the project
# to the browser; they are not secrets. Security is enforced by the Firestore rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase Emulator Suite (auth :9099, firestore :8080) instead of the real project.
NEXT_PUBLIC_USE_EMULATORS=false
